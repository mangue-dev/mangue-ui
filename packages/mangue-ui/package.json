{
  "name": "mangue-ui",
  "version": "0.6.0",
  "description": "Design system and component library extracted from project: radix-nova shadcn primitives, a decoupled app shell (sidebar / header / command menu), an AI chat panel, and OKLch design tokens.",
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "design-system",
    "component-library",
    "radix",
    "shadcn"
  ],
  "author": "mangué",
  "license": "MIT",
  "homepage": "https://github.com/mangue-dev/mangue-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangue-dev/mangue-ui.git",
    "directory": "packages/mangue-ui"
  },
  "bugs": {
    "url": "https://github.com/mangue-dev/mangue-ui/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json",
    "./*": {
      "types": ["./src/*.tsx", "./src/*.ts"],
      "default": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@lobehub/icons": "^5.13.0",
    "@radix-ui/react-switch": "^1.2.2",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react-colorful": "^5.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
